{
  "name": "ned",
  "productName": "Ned",
  "version": "0.3.0",
  "private": true,
  "description": "Offline managed Zed IDE and OpenCode vibe coding workspace",
  "license": "MIT",
  "author": "SungKyu Kim",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/ned-package.mjs dev",
    "build": "node scripts/ned-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "verify": "npm run build && npm run typecheck && npm run skills:verify && npm test",
    "skills:bundle": "node scripts/bundle-skills.mjs fetch",
    "skills:verify": "node scripts/bundle-skills.mjs verify",
    "start": "node scripts/ned-package.mjs dev",
    "vendor:fetch": "node scripts/vendor.mjs fetch",
    "vendor:verify": "node scripts/vendor.mjs verify",
    "package:win": "node scripts/ned-package.mjs package",
    "preview": "vite --host 0.0.0.0",
    "test:ui": "node scripts/desktop.mjs dev",
    "format": "prettier --write src scripts tests vite.config.ts tsconfig.json package.json",
    "dev:prototype": "node scripts/dev.mjs",
    "build:prototype": "node scripts/build.mjs",
    "start:prototype": "electron .",
    "test:ui:prototype": "node scripts/ui-smoke.mjs",
    "desktop:prepare": "node scripts/desktop.mjs prepare",
    "desktop:verify": "node scripts/desktop.mjs verify",
    "bundle:python": "python3 scripts/bundle-python.py fetch",
    "bundle:rea": "python3 scripts/bundle-rea.py fetch",
    "bundle:mcp": "python3 scripts/bundle-mcp.py fetch",
    "mcp:verify": "python3 scripts/bundle-mcp.py verify",
    "test:mcp:live": "tsx scripts/test-mcp-live.ts",
    "bundle:offline": "node scripts/ned-package.mjs bundle",
    "audit:installer": "node scripts/ned-package.mjs audit",
    "ned:build": "node scripts/ned-build.mjs",
    "desktop:build:legacy": "node scripts/desktop.mjs build",
    "desktop:package:legacy": "node scripts/desktop.mjs package",
    "ned:prepare": "node scripts/ned-package.mjs prepare"
  },
  "dependencies": {
    "diff": "8.0.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/diff": "7.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "resedit": "3.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "build": {
    "appId": "com.lig.ned",
    "productName": "Ned",
    "asar": true,
    "toolsets": {
      "wine": "1.0.1"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/runtime/windows-x64",
        "to": "runtime/windows-x64"
      },
      {
        "from": "vendor/runtime/manifest.json",
        "to": "runtime/manifest.json"
      },
      {
        "from": "vendor/sources",
        "to": "methodologies"
      },
      {
        "from": "vendor-lock.json",
        "to": "vendor-lock.json"
      },
      {
        "from": "vendor/LICENSE.OpenCode.txt",
        "to": "licenses/OpenCode.txt"
      },
      {
        "from": "vendor/THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Ned-${version}-Setup.${ext}",
      "icon": "assets/ned-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer/custom.nsh"
    }
  }
}
